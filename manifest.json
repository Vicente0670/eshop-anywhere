{
  "name": "eShop Anywhere",
  "description": "Relive 2013 with music from the eShop while browsing your favorite online stores!",
  "version": "1.0.0",
  "manifest_version": 3,
  "icons": {
    "16": "icons/icon_x16.png",
    "32": "icons/icon_x32.png",
    "48": "icons/icon_x48.png",
    "64": "icons/icon_x64.png",
    "128": "icons/icon_x128.png"
  },

  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/icon_x16.png",
      "48": "icons/icon_x48.png"
    }
  },
  "background": {
    "service_worker": "src/background/background.ts",
    "type": "module"
  },
  "incognito": "split",

  "permissions": [
    "activeTab",
    "offscreen",
    "storage",
    "tabs"
  ]
}